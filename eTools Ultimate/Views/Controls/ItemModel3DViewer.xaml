<UserControl
    x:Class="eTools_Ultimate.Views.Controls.ItemModel3DViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="http://schemas.lepo.co/i18n/2022/xaml"
    xmlns:local="clr-namespace:eTools_Ultimate.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Border
            Grid.Row="0"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <local:Model3DRenderer D3DHost="{Binding D3DHost, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Border
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Opacity="0.95">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon
                            Margin="0,0,0,10"
                            FontSize="48"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Symbol="Warning24" />
                        <TextBlock
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Error.Title, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock
                            MaxWidth="250"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Error.Description, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <!--  Control Buttons Overlay  -->
                <StackPanel
                    Margin="0,5,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Panel.ZIndex="1"
                    Orientation="Vertical">
                    <ui:Button Command="{Binding RenderLootModelCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{i18n:StringLocalizer 'View loot model'}">
                        <ui:SymbolIcon Symbol="ImageReflection24" />
                    </ui:Button>
                    <ui:Button Command="{Binding RenderMalePartModelCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{i18n:StringLocalizer 'View male part model'}">
                        <ui:SymbolIcon Symbol="ImageReflection24" />
                    </ui:Button>
                    <ui:Button Command="{Binding RenderFemalePartModelCommand, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{i18n:StringLocalizer 'View female part model'}">
                        <ui:SymbolIcon Symbol="ImageReflection24" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
